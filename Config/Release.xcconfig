//
// Release.xcconfig - Production configuration
// Used for Archive / App Store builds. Do NOT include Local.xcconfig here.
//

// Workaround: xcconfig treats // as comment, so we build https:// via SLASH variable
SLASH = /
API_BASE_HOST = oura-studio-backend.fastapicloud.dev/api/v1
API_BASE_URL = https:/$(SLASH)$(API_BASE_HOST)
